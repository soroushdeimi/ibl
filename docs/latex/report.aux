\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Decoder AUC for the \emph  {new} block as a function of trials since a $0.2\leftrightarrow 0.8$ reversal. Shaded band: lag~1, the only lag at which prior and history are opposed. Left: behaviour only. Middle: neural counts. Right: neural residuals. MOp is underpowered (dashed). \textbf  {These panels were not recomputed after the window change.} Bands are 95\% bootstrap intervals over reversals.}}{8}{figure.caption.14}\protected@file@percent }
\newlabel{fig:reversal}{{5}{8}{Decoder AUC for the \emph {new} block as a function of trials since a $0.2\leftrightarrow 0.8$ reversal. Shaded band: lag~1, the only lag at which prior and history are opposed. Left: behaviour only. Middle: neural counts. Right: neural residuals. MOp is underpowered (dashed). \textbf {These panels were not recomputed after the window change.} Bands are 95\% bootstrap intervals over reversals}{figure.caption.14}{}}
